{
  "name": "aerofly-connect-pc",
  "version": "2.2.1",
  "description": "Aerofly Connect for PC",
  "main": "main.js",
  "author": "Cayden",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/core.test.js && node test/phase.test.js && node test/atc.test.js && node test/voice.test.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aeroflyconnect.pc",
    "productName": "AFConnectPC",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "overlay-preload.js", "web-preload.js", "core/**", "renderer/**", "assets/**"],
    "win": { "target": "portable", "icon": "assets/icon.png", "artifactName": "AFConnectPC.exe" },
    "portable": { "artifactName": "AFConnectPC.exe" }
  }
}
